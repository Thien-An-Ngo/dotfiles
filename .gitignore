# ─── Browser profiles ────────────────────────────────────────────────────────
google-chrome/
google-chrome-for-testing/

# ─── IDE / application data ──────────────────────────────────────────────────
Code/
vscode-sqltools/

# ─── Agent tool caches (crush/goose are just symlinks to ~/.agents/skills) ──
crush/
goose/

# ─── System / runtime state ──────────────────────────────────────────────────
pulse/
wslu/
configstore/
encore/
mimeapps.list

# ─── Poetry project files (not user config) ──────────────────────────────────
dot_config/pypoetry/poetry.lock
dot_config/pypoetry/pyproject.toml

# ─── gh auth tokens ──────────────────────────────────────────────────────────
dot_config/gh/hosts.yml

# ─── Micro editor state ──────────────────────────────────────────────────────
dot_config/micro/backups/
dot_config/micro/buffers/

# ─── thefuck compiled cache ──────────────────────────────────────────────────
dot_config/thefuck/__pycache__/

# ─── systemd (work-specific, machine-generated — never commit) ────────────────
systemd/

# ─── Backups created by install.sh ───────────────────────────────────────────
*.bak
.dotfiles-backup-*/

# ─── Chezmoi machine-local config (never committed — contains sourceDir + age key path) ──
chezmoi/chezmoi.toml

# ─── Claude Code local settings (machine-specific) ───────────────────────────
.claude/settings.local.json
.claude/worktrees/

# ─── Secrets / sensitive ─────────────────────────────────────────────────────
.env
.env.*
.zsh_history
.bash_history
.zshrc.local
