[Unit]
Description=OpenClaw Gateway (v2026.5.6)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
ExecStart=/home/labor-client18/.nvm/versions/node/v22.22.0/bin/node /home/labor-client18/.nvm/versions/node/v22.22.0/lib/node_modules/openclaw/dist/index.js gateway --port 18789
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
Environment=HOME=/home/labor-client18
Environment=TMPDIR=/tmp
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
Environment=PATH=/home/labor-client18/.nvm/versions/node/v22.22.0/bin:/home/labor-client18/.bun/bin:/home/labor-client18/.nvm/current/bin:/home/labor-client18/.local/bin:/home/labor-client18/.npm-global/bin:/home/labor-client18/bin:/home/labor-client18/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.5.6

[Install]
WantedBy=default.target
