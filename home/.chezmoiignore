# .chezmoiignore — tells chezmoi which files in the source dir are NOT dotfiles
# to be applied to the home directory. Everything listed here is repo
# infrastructure, not a managed dotfile.

# ─── Repo meta ────────────────────────────────────────────────────────────────
README.md
CLAUDE.md
.gitignore
.chezmoiignore

# ─── Planning documents ───────────────────────────────────────────────────────
plan/

# ─── System-specific install scripts ─────────────────────────────────────────
arch/
apt/
brew/
nix/
nixos/
windows/

# ─── Shared scripts (called by run_once, not dotfiles) ───────────────────────
scripts/

dot_zshrc.local.example

# ─── Chezmoi machine-local config ────────────────────────────────────────────
# chezmoi/chezmoi.toml is gitignored above; this guards against it
# accidentally appearing to chezmoi as a managed file
chezmoi/chezmoi.toml

# ─── Chezmoi config dir (machine-local, gitignored) ──────────────────────────
chezmoi/

# ─── Windows-only run_once script — skip on non-Windows ──────────────────────
{{- if ne .chezmoi.os "windows" }}
run_once_windows-setup.ps1.tmpl
run_once_windows-setup.ps1
{{- end }}

# ─── Unix-only dotfiles — skip on Windows ────────────────────────────────────
{{- if eq .chezmoi.os "windows" }}
dot_zshrc.tmpl
dot_zprofile.tmpl
dot_zshenv
dot_tmux.conf.tmpl
{{- end }}
